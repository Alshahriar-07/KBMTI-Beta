# KBMTI backend configuration.
# Copy to .env and edit as needed. Never commit .env.
# All values below are optional; the defaults shown are the built-in defaults.
#
# Desktop launch (`python -m kbmti`) chooses free loopback ports and sets
# KBMTI_HOST / KBMTI_PORT for the child backend automatically. The values below
# apply when the backend is started directly.

# --- Licensing ------------------------------------------------------------
# Required for every licensed launch. Use HTTPS for a remote service.
# Local development example: http://127.0.0.1:8790
KBMTI_LICENSE_SERVER_URL=https://license.example.com

# --- Server ---------------------------------------------------------------
KBMTI_HOST=127.0.0.1
KBMTI_PORT=8756
# Data directory for SQLite, logs and caches. Defaults to %LOCALAPPDATA%/KBMTI
# KBMTI_DATA_DIR=C:/Users/you/AppData/Local/KBMTI
# KBMTI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost
KBMTI_MAX_REQUEST_BYTES=1048576

# --- Market data / Binance ------------------------------------------------
# Public market-data endpoints only. No Binance API key or secret is required
# and none is accepted by this application.
KBMTI_DEFAULT_PROVIDER=binance
KBMTI_BINANCE_REST_URL=https://data-api.binance.vision
KBMTI_BINANCE_WS_URL=wss://stream.binance.com:9443
KBMTI_BINANCE_SYMBOL=BTCUSDT
KBMTI_BINANCE_TIMEOUT=12
KBMTI_DEFAULT_TIMEFRAME=M15
KBMTI_DEFAULT_CANDLE_LIMIT=500
KBMTI_POLL_INTERVAL=1.0
KBMTI_CANDLE_REFRESH=5.0
KBMTI_STALE_SECONDS=120

# --- PATRON model ---------------------------------------------------------
KBMTI_PATRON_ENABLED=true
# Load in the background at startup. Set false to load lazily on first request.
KBMTI_PATRON_AUTOLOAD=true
KBMTI_PATRON_CHECKPOINT=backend/models/patron/best.pt
KBMTI_PATRON_WARMUP=backend/data/patron/BTCUSDT_15m.parquet
KBMTI_PATRON_CONFIG=PATRON/configs/model_config.yaml
KBMTI_PATRON_THREADS=4
KBMTI_PATRON_HISTORY_BARS=520

# --- MetaTrader 5 (optional secondary feed) -------------------------------
# MT5 is only used when KBMTI_DEFAULT_PROVIDER=mt5. PATRON always uses Binance
# BTC/USDT 15m data, regardless of the chart provider.
# KBMTI_MT5_TIMEOUT_MS=15000
