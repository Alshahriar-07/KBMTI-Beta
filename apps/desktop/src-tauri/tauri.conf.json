{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KBMTI",
  "version": "1.0.0",
  "identifier": "com.kbmiti.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KBMTI — Kronos BTC Market Intelligence",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 760,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "backgroundColor": "#F8FAFC"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' http://127.0.0.1:8756 ws://127.0.0.1:8756"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Finance",
    "shortDescription": "Kronos BTC Market Intelligence",
    "longDescription": "KBMTI is a read-only MetaTrader 5 market intelligence desktop application for BTC. It renders live candles and indicators and reserves AI forecasting for Stage 2. It never places orders.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
